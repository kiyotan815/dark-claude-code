#!/usr/bin/env bash
#
# dcc — dark-claude-code の host 側 wrapper。
# devcontainer 起動 + Claude Code 起動を 1 コマンドにまとめ、
# キット (plugin) の登録・更新・キット本体への改善 (PR 等) もここから行う。
#
# 使い方:
#   dcc               # devcontainer up (未作成なら作成) + claude 起動
#   dcc shell         # devcontainer up + bash で入る
#   dcc up            # コンテナ起動のみ
#   dcc rebuild       # コンテナ作り直し + claude 起動
#   dcc init [-y]     # カレントプロジェクトへ .devcontainer + AGENTS.md/CLAUDE.md を展開。
#                     # 旧 init 済みのプロジェクトで再実行すると移行する（.claude/ のキット由来コピーを
#                     # 確認の上で削除、postCreate.sh を新版へ）。-y で確認を省略
#   dcc link-host     # host の ~/.claude / ~/.codex をキット参照にし、plugin を登録・install（コンテナ不要運用）
#   dcc sync          # marketplace / plugin を更新（GitHub 経由で install した環境向け）
#   dcc kit [args]    # キット repo で claude を起動 (改善・PR 作成用)
#   dcc <claude args> # 上記以外の引数はそのまま claude へ (例: dcc --continue)
#
# 本体はキット repo 内にあり、PATH 上には symlink を置く想定:
#   ln -sf <kit>/bin/dcc ~/.local/bin/dcc
set -euo pipefail

# realpath が無い環境 (古い macOS) 向けフォールバック
command -v realpath >/dev/null 2>&1 \
  || realpath() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
KIT_ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
MARKETPLACE="dark-claude-code"   # .claude-plugin/marketplace.json の name
PLUGIN="dcc@$MARKETPLACE"        # .claude-plugin/plugin.json の name @ marketplace

log() { printf '\033[36m[dcc]\033[0m %s\n' "$*"; }
die() { printf 'dcc: %s\n' "$*" >&2; exit 1; }

need_devcontainer() {
  command -v devcontainer >/dev/null 2>&1 \
    || die "devcontainer CLI が必要です: npm install -g @devcontainers/cli"
}

need_claude() {
  command -v claude >/dev/null 2>&1 \
    || die "host に claude が必要です: npm install -g @anthropic-ai/claude-code"
}

# .devcontainer/ を持つ最も近い親ディレクトリを workspace とする
find_workspace() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.devcontainer/devcontainer.json" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  die ".devcontainer/devcontainer.json が見つかりません (dcc init で展開できます)"
}

up() { need_devcontainer; devcontainer up --workspace-folder "$@"; }
run_in() { need_devcontainer; exec devcontainer exec --workspace-folder "$@"; }

# AGENTS.md を正とし、CLAUDE.md は symlink にして Claude / Codex で指示を共有する
setup_agents_md() {
  if [ ! -e AGENTS.md ] && [ ! -L AGENTS.md ]; then
    if [ -e CLAUDE.md ]; then
      ln -s CLAUDE.md AGENTS.md
      log "AGENTS.md -> CLAUDE.md (symlink)"
    else
      printf '# AGENTS.md\n\nプロジェクト固有の指示をここに書く（Claude Code / Codex 共通。CLAUDE.md は symlink）。\n' > AGENTS.md
      log "AGENTS.md を作成しました"
    fi
  fi
  if [ ! -e CLAUDE.md ] && [ ! -L CLAUDE.md ]; then
    ln -s AGENTS.md CLAUDE.md
    log "CLAUDE.md -> AGENTS.md (symlink)"
  fi
}

# ファイルの内容がキット repo の履歴に存在する blob と一致すれば真（= キット由来で未改変）
is_kit_blob() {
  local h
  h="$(git hash-object "$1" 2>/dev/null)" || return 1
  git -C "$KIT_ROOT" cat-file -e "${h}^{blob}" 2>/dev/null
}

# .devcontainer/ の配置と更新。postCreate.sh はキット所有なので新版へ差し替えるが、
# プロジェクト側で改変されている（キットのどの版とも一致しない）場合は上書きせず警告する。
# devcontainer.json は image 差し替え等の余地があるので触らない
setup_devcontainer() {
  if [ ! -d .devcontainer ]; then
    cp -R "$KIT_ROOT/.devcontainer" .devcontainer
    log ".devcontainer/ を配置しました"
    return 0
  fi
  local src="$KIT_ROOT/.devcontainer/postCreate.sh" dst=".devcontainer/postCreate.sh"
  if [ -f "$dst" ] && cmp -s "$src" "$dst"; then
    log "ok:   $dst (最新)"
  elif [ -f "$dst" ] && ! is_kit_blob "$dst"; then
    log "warn: $dst はプロジェクト側で改変されているため上書きしません。plugin install を含む新版: $src"
  else
    cp "$src" "$dst" && chmod +x "$dst"
    log "update: $dst (キットの新版へ差し替え。devcontainer.json は変更しない)"
  fi
}

# キット repo が過去に配布したことのあるパス（旧 dcc sync の対象ディレクトリ）
kit_history_paths() {
  git -C "$KIT_ROOT" log --format= --name-only --all \
    -- commands agents skills hooks mcp-configs scripts/hooks 2>/dev/null | sort -u
}

# .claude/settings*.json から参照されているパスか（opt-in hook 等は残す）
referenced_in_settings() {
  local f
  for f in .claude/settings.json .claude/settings.local.json; do
    [ -f "$f" ] && grep -qF -- "$1" "$f" && return 0
  done
  return 1
}

# 旧 dcc sync が .claude/ にコピーしたキット由来ファイルを削除する（plugin と二重になるため）。
# 残すもの: プロジェクト独自のファイル（キット履歴に無いパス）、settings から参照されているもの、
# プロジェクト側で改変されているもの（警告のみ）。削除前に一覧を出して確認する
cleanup_legacy_copies() {
  [ -d .claude ] || return 0
  local hist
  hist="$(kit_history_paths || true)"
  if [ -z "$hist" ]; then
    log "warn: キット repo の git 履歴を読めないため .claude/ の掃除をスキップ（shallow clone?）"
    return 0
  fi
  local targets modified p name f changed
  targets=(); modified=()
  # commands/ agents/ hooks/ mcp-configs/ scripts/hooks/ はファイル単位
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in skills/*) continue ;; esac
    [ -f ".claude/$p" ] || continue
    if referenced_in_settings "$p"; then
      log "keep: .claude/$p (settings.json から参照)"
    elif is_kit_blob ".claude/$p"; then
      targets+=(".claude/$p")
    else
      modified+=(".claude/$p")
    fi
  done <<<"$hist"
  # skills/ はディレクトリ単位。1 ファイルでも改変があれば残す
  while IFS= read -r name; do
    [ -n "$name" ] && [ -d ".claude/skills/$name" ] || continue
    if referenced_in_settings "skills/$name"; then
      log "keep: .claude/skills/$name (settings.json から参照)"
      continue
    fi
    changed=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      is_kit_blob "$f" || { changed=1; break; }
    done <<<"$(find ".claude/skills/$name" -type f)"
    if [ "$changed" = 0 ]; then
      targets+=(".claude/skills/$name")
    else
      modified+=(".claude/skills/$name/")
    fi
  done <<<"$(printf '%s\n' "$hist" | awk -F/ '$1=="skills" && NF>=3 {print $2}' | sort -u)"

  if [ ${#modified[@]} -gt 0 ]; then
    log "warn: キット由来だがプロジェクト側で改変されているため残します（plugin と二重。不要なら手で削除）:"
    printf '        %s\n' ${modified[@]+"${modified[@]}"}
  fi
  if [ ${#targets[@]} -eq 0 ]; then
    log "ok:   .claude/ にキット由来のコピーは無し"
    return 0
  fi
  log "旧 dcc sync のコピー ${#targets[@]} 件を削除します（plugin $PLUGIN と二重になるため）:"
  printf '        %s\n' ${targets[@]+"${targets[@]}"}
  if [ "$ASSUME_YES" != 1 ]; then
    local ans=""
    # 端末が無い（CI / パイプ実行）ときは削除しない
    if (: </dev/tty) 2>/dev/null; then
      read -r -p "削除しますか? [y/N] " ans </dev/tty
    fi
    if [[ ! "$ans" =~ ^[Yy]$ ]]; then
      log "skip: 削除を見送りました（確認なしで実行するなら dcc init -y）"
      return 0
    fi
  fi
  rm -rf -- ${targets[@]+"${targets[@]}"}
  # 空になった旧 sync 先ディレクトリだけ畳む（中身のある階層や .claude/ 直下の他のものは触らない）
  local d
  for d in commands agents hooks mcp-configs scripts/hooks scripts skills; do
    [ -d ".claude/$d" ] && rmdir ".claude/$d" 2>/dev/null || true   # 中身が残っていれば何もしない
  done
  log "rm:   ${#targets[@]} 件を削除しました（git 管理下なら git checkout で復元可）"
}

ASSUME_YES=0
cmd_init() {
  local a
  for a in "$@"; do
    case "$a" in
      -y|--yes) ASSUME_YES=1 ;;
      *) die "init の不明な引数: $a（使えるのは -y）" ;;
    esac
  done
  setup_devcontainer
  cleanup_legacy_copies
  setup_agents_md
  log "展開完了。skill / agent / command は plugin ($PLUGIN) が供給します（host: dcc link-host、コンテナ: postCreate が install）"
}

# plugin の登録と install（冪等）。host ではキットのローカルパスを marketplace として登録するので、
# キットを編集した内容がそのまま次のセッションに反映される（in-place load）
# 注意: 出力は先に変数へ取る（pipefail 下で grep -q が先に閉じると SIGPIPE で偽になる）
register_plugin() {
  need_claude
  local out
  out="$(claude plugin marketplace list 2>/dev/null || true)"
  if grep -qE "(^|[[:space:]])${MARKETPLACE}([[:space:]]|$)" <<<"$out"; then
    log "ok:   marketplace $MARKETPLACE (登録済み。source を切り替えるなら: claude plugin marketplace remove $MARKETPLACE してから再実行)"
  else
    claude plugin marketplace add "$KIT_ROOT" \
      || die "marketplace の登録に失敗。再実行: claude plugin marketplace add $KIT_ROOT"
  fi
  out="$(claude plugin list 2>/dev/null || true)"
  if grep -qF "$PLUGIN" <<<"$out"; then
    log "ok:   plugin $PLUGIN (install 済み)"
  else
    claude plugin install "$PLUGIN" \
      || die "plugin の install に失敗。再実行: claude plugin install $PLUGIN"
  fi
}

cmd_sync() {
  need_claude
  claude plugin marketplace update "$MARKETPLACE"
  claude plugin update "$PLUGIN"
  log "plugin を更新しました（起動中のセッションは /reload-plugins）"
}

# 既存の実体ファイルは退避してからキットへの symlink に置き換える
link_item() {
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    log "ok:   $dst (リンク済み)"
    return 0
  fi
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    local bak
    bak="$dst.pre-dcc.$(date +%Y%m%d%H%M%S)"
    mv "$dst" "$bak"
    log "退避: $dst -> $bak"
  fi
  ln -s "$src" "$dst"
  log "link: $dst -> $src"
}

# mutable な設定（ツールが実行時に書き換えるもの）は初期値としてのみ配る
copy_if_missing() {
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    log "keep: $dst (既存を維持)"
  else
    cp "$src" "$dst"
    log "copy: $dst (初期値)"
  fi
}

# 旧配布方式（キット内ファイルへの直接 symlink）の残骸を片付ける
cleanup_legacy_links() {
  local p
  for p in "$HOME/.claude/skills/continuous-learning-v2" \
           "$HOME/.claude/commands/save-memory.md" \
           "$HOME/.claude/commands/memory-show.md" \
           "$HOME/.claude/commands/memory-clean.md"; do
    if [ -L "$p" ] && [ ! -e "$p" ]; then
      rm "$p"
      log "rm:   $p (キットから削除済みの symlink)"
    fi
  done
}

cmd_link_host() {
  mkdir -p "$HOME/.claude" "$HOME/.codex"
  link_item "$KIT_ROOT/claude-global/CLAUDE.md"     "$HOME/.claude/CLAUDE.md"
  link_item "$KIT_ROOT/claude-global/statusline.sh" "$HOME/.claude/statusline.sh"
  link_item "$KIT_ROOT/rules"                       "$HOME/.claude/rules"
  link_item "$KIT_ROOT/codex-global/AGENTS.md"      "$HOME/.codex/AGENTS.md"
  copy_if_missing "$KIT_ROOT/claude-global/settings.json" "$HOME/.claude/settings.json"
  copy_if_missing "$KIT_ROOT/codex-global/config.toml"    "$HOME/.codex/config.toml"
  cleanup_legacy_links
  register_plugin
  log "host のグローバル設定をキット参照にし、plugin $PLUGIN を有効化しました (source: $KIT_ROOT)"
}

cmd_kit() {
  need_claude
  cd "$KIT_ROOT"
  exec claude "$@"
}

case "${1:-}" in
  init)      shift; cmd_init "$@" ;;
  sync)      cmd_sync ;;
  link-host) cmd_link_host ;;
  kit)       shift; cmd_kit "$@" ;;
  up)        up "$(find_workspace)" ;;
  rebuild)   shift
             ws="$(find_workspace)"
             up "$ws" --remove-existing-container
             run_in "$ws" claude "$@" ;;
  shell)     shift
             ws="$(find_workspace)"
             up "$ws"
             run_in "$ws" bash "$@" ;;
  *)         ws="$(find_workspace)"
             up "$ws"
             run_in "$ws" claude "$@" ;;
esac
